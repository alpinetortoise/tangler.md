#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf '%s\n' \
        'Usage: gather [--output FILE] [--root DIR] PATH...' \
        '' \
        'Gather files into Markdown blocks accepted by tangler.'
}

die() {
    printf 'gather: %s\n' "$1" >&2
    exit 1
}

output=-
root=.
declare -a inputs=()

while (($#)); do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        -o|--output)
            (($# >= 2)) || die "missing argument for $1"
            output=$2
            shift 2
            ;;
        --root)
            (($# >= 2)) || die "missing argument for $1"
            root=$2
            shift 2
            ;;
        --)
            shift
            inputs+=("$@")
            break
            ;;
        -* )
            die "unknown option: $1"
            ;;
        *)
            inputs+=("$1")
            shift
            ;;
    esac
done

((${#inputs[@]} > 0)) || { usage >&2; exit 2; }
[[ -d $root ]] || die "root is not a directory: $root"

declare -a paths=()
declare -A seen=()

add_path() {
    local path=$1
    [[ -f $path && -r $path ]] || die "cannot read file: $path"
    [[ -z ${seen[$path]+set} ]] || return
    seen[$path]=1
    paths+=("$path")
}

for input in "${inputs[@]}"; do
    if [[ -d $input ]]; then
        while IFS= read -r -d '' path; do
            add_path "$path"
        done < <(find "$input" -type f -print0 | sort -z)
    else
        add_path "$input"
    fi
done

relative_path() {
    local path=$1
    if [[ $path == "$root"/* ]]; then
        path=${path#"$root"/}
    elif [[ $path == ./* ]]; then
        path=${path#./}
    fi
    printf '%s' "$path"
}

fence_for() {
    local path=$1
    local maximum
    maximum=$(awk 'match($0, /^`+/) && RLENGTH > maximum { maximum = RLENGTH } END { print maximum + 1 }' "$path")
    ((maximum < 3)) && maximum=3
    printf '%*s' "$maximum" '' | tr ' ' '`'
}

write_block() {
    local path=$1
    local relative fence
    relative=$(relative_path "$path")
    fence=$(fence_for "$path")
    printf '%s file=%s\n' "$fence" "$relative"
    cat "$path"
    if [[ -s $path ]]; then
        last_byte=$(tail -c 1 "$path" | od -An -t x1)
        [[ $last_byte == *0a* ]] || printf '\n'
    fi
    printf '%s\n\n' "$fence"
}

if [[ $output == - ]]; then
    for path in "${paths[@]}"; do
        write_block "$path"
    done
else
    mkdir -p "$(dirname "$output")"
    : > "$output"
    for path in "${paths[@]}"; do
        write_block "$path" >> "$output"
    done
    printf 'gathered %s file(s) into %s\n' "${#paths[@]}" "$output" >&2
fi